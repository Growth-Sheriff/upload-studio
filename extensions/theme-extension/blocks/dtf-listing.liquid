{{ 'dtf-listing.css' | asset_url | stylesheet_tag }}

<div class="dtf-listing" id="dtf-listing-root">
  {% if block.settings.heading != blank %}
    <div class="dtf-listing__header">
      <h2 class="dtf-listing__title">{{ block.settings.heading }}</h2>
      {% if block.settings.subheading != blank %}
        <p class="dtf-listing__subtitle">{{ block.settings.subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="dtf-listing__grid">
    {% assign items = block.settings.products %}
    {% if items.size > 0 %}
      {% for item in items %}
        <div class="dtf-listing__card">
          <div class="dtf-listing__card-media">
            {% if item.featured_image %}
              <img
                src="{{ item.featured_image | image_url: width: 480 }}"
                alt="{{ item.title | escape }}"
                loading="lazy"
                width="240"
                height="240"
              >
            {% else %}
              <div class="dtf-listing__card-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="m21 15-5-5L5 21"/>
                </svg>
              </div>
            {% endif %}
          </div>
          <div class="dtf-listing__card-body">
            <h3 class="dtf-listing__card-title">{{ item.title }}</h3>
            <p class="dtf-listing__card-price">{{ item.price | money_without_trailing_zeros }}</p>
            <a class="dtf-listing__upload-btn" href="{{ item.url }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M9 18l6-6-6-6"/>
              </svg>
              Open product
            </a>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="dtf-listing__empty"><p>Select products in block settings.</p></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "DTF Product Listing",
  "target": "section",
  "templates": ["product", "collection", "index", "page"],
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Gang Sheet Products"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "Choose a product to upload a finished sheet or select a variant"},
    {"type": "product_list", "id": "products", "label": "Products", "limit": 8}
  ]
}
{% endschema %}
