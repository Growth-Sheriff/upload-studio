{% render 'app-proxy-config', proxy_path: block.settings.app_proxy_path %}
{{ 'dtf-transfer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ul-state.js' | asset_url }}" defer></script>
<script>
  window.ULCustomer = {
    id: {{ customer.id | default: 'null' }}
  };
</script>
{% render 'dtf-uploader', product: product, proxy_path: block.settings.app_proxy_path %}
{% render 'tshirt-modal' %}
{% render 'confirmation-screen' %}
{% schema %}
{
  "name": "Main Product Upload",
  "target": "section",
  "templates": ["product"],
  "settings": [
    { "type": "text", "id": "app_proxy_path", "label": "Storefront app proxy path", "default": "/apps/customizer", "info": "If renamed in Shopify app settings, use the same /apps/name path in all uploader blocks and the cart embed." },
    {
      "type": "paragraph",
      "content": "This block displays the DTF upload widget and 3D T-Shirt designer. Configure product settings in the Upload Studio app dashboard."
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "text",
      "id": "header_text",
      "label": "Header text",
      "default": "Upload Your Design"
    }
  ]
}
{% endschema %}
