{% render 'app-proxy-config', proxy_path: block.settings.app_proxy_path %}
<script src="{{ 'cart-upload-display.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Cart Upload Display",
  "target": "body",
  "javascript": "cart-upload-display.js",
  "settings": [
    { "type": "text", "id": "app_proxy_path", "label": "Storefront app proxy path", "default": "/apps/customizer", "info": "If renamed in Shopify app settings, use the same /apps/name path in all uploader blocks and this cart embed." },
    {
      "type": "paragraph",
      "content": "Shows uploaded design info under cart line items. Match the storefront proxy path if you renamed it in Shopify."
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable cart display",
      "default": true
    }
  ]
}
{% endschema %}
