{{ 'main-product-upload-app.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ul-upload-telemetry.js' | asset_url }}" defer></script>
<script src="{{ 'ul-multipart-uploader.js' | asset_url }}" defer></script>
<script src="{{ 'ul-file-probe.js' | asset_url }}" defer></script>
<script src="{{ 'main-product-upload-app.js' | asset_url }}" defer></script>
{%- assign ump_default_accept = ".png,.jpg,.jpeg,.webp,.tif,.tiff,.psd,.pdf,.ai,.eps,.svg,image/png,image/jpeg,image/webp,image/tiff,image/x-tiff,image/vnd.adobe.photoshop,application/vnd.adobe.photoshop,application/x-photoshop,image/x-psd,application/photoshop,application/psd,application/pdf,application/postscript,application/illustrator,application/vnd.adobe.illustrator,application/eps,application/x-eps,image/x-eps,image/svg+xml" -%}
{%- assign ump_accept = block.settings.accepted_files | default: ump_default_accept -%}
{%- if ump_accept == ".png" or ump_accept == ".png,image/png" -%}
  {%- assign ump_accept = ump_default_accept -%}
{%- endif -%}
{%- assign ump_roll_width = block.settings.roll_width_in | default: 22 -%}
{%- assign ump_accent = block.settings.accent_color | default: "#4f7cff" -%}
<section
  class="ump"
  data-ul-main-product-upload-app
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-current-variant-id="{{ product.selected_or_first_available_variant.id | default: '' }}"
  data-product-variants="{{ product.variants | json | escape }}"
  data-product-options="{{ product.options_with_values | json | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | default: 'USD' }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-customer-id="{{ customer.id | default: '' }}"
  data-customer-email="{{ customer.email | default: '' | escape }}"
  data-customer-name="{{ customer.name | default: '' | escape }}"
  data-api-base="/apps/customizer"
  data-roll-width-in="{{ ump_roll_width }}"
  data-accepted-files="{{ ump_accept | escape }}"
  data-enable-checkout="{{ block.settings.enable_checkout_button }}"
  style="--ump-accent: {{ ump_accent }};"
>
  <div class="ump__shell">
    <div class="ump__workspace">
      <div class="ump__drop" data-ump-dropzone>
        <input class="ump__input" data-ump-input type="file" accept="{{ ump_accept | escape }}" multiple />
        <div class="ump__drop-grid" aria-hidden="true"></div>
        <div class="ump__drop-main">
          {%- if block.settings.show_product_title -%}
            <p class="ump__product-name">{{ product.title | escape }}</p>
          {%- endif -%}
          <h2 class="ump__title">{{ block.settings.heading | default: 'Upload your gang sheet' }}</h2>
          <button class="ump__upload-btn ump__upload-btn--live" type="button" data-ump-upload-trigger>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"></path><path d="m6 10 6-6 6 6"></path><path d="M4 20h16"></path></svg>
            <span>{{ block.settings.upload_label | default: 'Upload files' }}</span>
            <em>or drop them here</em>
          </button>
          <ul class="ump__specs" aria-label="Accepted files">
            <li class="ump__spec--roll">{{ ump_roll_width }}&quot; roll</li>
            <li>PNG</li><li>JPG</li><li>TIFF</li><li>PSD</li><li>PDF</li><li>AI</li><li>EPS</li><li>SVG</li>
          </ul>
        </div>
        <div class="ump__drop-overlay" aria-hidden="true"><span>Drop to upload</span></div>
      </div>

      {%- comment -%} Transfer strip: visible only while a file is uploading, measuring or failed. {%- endcomment -%}
      <div class="ump__status" data-ump-status-panel hidden>
        <div class="ump__file">
          <img class="ump__thumb" data-ump-thumb alt="" width="48" height="48" hidden>
          <div>
            <p class="ump__file-name" data-ump-file-name></p>
            <p class="ump__file-meta" data-ump-file-meta></p>
            <div class="ump__file-pills" data-ump-file-pills hidden>
              <span class="ump__pill" data-ump-pill-size></span>
              <span class="ump__pill ump__pill--type" data-ump-pill-type></span>
              <span class="ump__pill ump__pill--multipart" data-ump-pill-multipart hidden>Parallel</span>
            </div>
          </div>
          <div class="ump__file-actions">
            <button class="ump__btn ump__btn--ghost ump__cancel" type="button" data-ump-cancel hidden>Cancel</button>
            <button class="ump__btn ump__btn--primary ump__retry" type="button" data-ump-retry hidden>Try again</button>
          </div>
        </div>
        <div class="ump__progress" data-ump-progress-wrap hidden>
          <div class="ump__progress-bar" data-ump-progress></div>
        </div>
        <div class="ump__progress-text" data-ump-progress-text hidden></div>
        <div class="ump__stage" data-ump-stage hidden>
          <span class="ump__stage-dot" data-ump-stage-upload></span>
          <span class="ump__stage-label" data-ump-stage-upload-label>Uploading</span>
          <span class="ump__stage-sep" aria-hidden="true"></span>
          <span class="ump__stage-dot" data-ump-stage-measure></span>
          <span class="ump__stage-label" data-ump-stage-measure-label>Measuring</span>
          <span class="ump__stage-sep" aria-hidden="true"></span>
          <span class="ump__stage-dot" data-ump-stage-ready></span>
          <span class="ump__stage-label" data-ump-stage-ready-label>Ready</span>
        </div>
      </div>

      {%- comment -%} Files list: one row per gang sheet, copies are per row. {%- endcomment -%}
      <div class="ump__files" data-ump-files hidden>
        <div class="ump__files-head">
          <h3 class="ump__card-title">Your files <span data-ump-files-count></span></h3>
          <button class="ump__btn ump__btn--ghost" type="button" data-ump-replace>Add more</button>
        </div>
        <div class="ump__queue" data-ump-queue></div>
      </div>

      <div class="ump__price-table-wrap" data-ump-price-table hidden></div>
    </div>

    <aside class="ump__inspector" aria-live="polite">
      <div class="ump__preview-card" data-ump-preview-card>
        <div class="ump__preview-head">
          <div>
            <p class="ump__eyebrow">Measured size</p>
            <h3 class="ump__size" data-ump-size>-- x --</h3>
          </div>
          <span class="ump__badge" data-ump-badge>Waiting</span>
        </div>

        {%- comment -%} Signature: true-scale roll preview. Tiles are drawn by JS at the printer's placement. {%- endcomment -%}
        <div class="ump__sheet" data-ump-sheet>
          <div class="ump__ruler ump__ruler--top" data-ump-ruler-top></div>
          <div class="ump__ruler ump__ruler--side" data-ump-ruler-side></div>
          <div class="ump__sheet-plane" data-ump-sheet-plane>
            <div class="ump__art" data-ump-art>
              <span class="ump__art-empty" data-ump-art-label>Your design appears here</span>
              <em class="ump__art-dim ump__art-dim--w" data-ump-art-dim-w hidden></em>
              <em class="ump__art-dim ump__art-dim--h" data-ump-art-dim-h hidden></em>
            </div>
            <span class="ump__sheet-cut" data-ump-sheet-cut hidden></span>
          </div>
        </div>

        <div class="ump__facts" data-ump-facts>
          <span class="ump__fact"><small>Sheet</small><strong data-ump-sheet-label>--</strong></span>
          <span class="ump__fact"><small>Width</small><strong data-ump-width>--</strong></span>
          <span class="ump__fact"><small>Height</small><strong data-ump-height>--</strong></span>
          <span class="ump__fact ump__quality" data-ump-quality hidden>
            <small>Quality</small>
            <strong><i class="ump__quality-dot" aria-hidden="true"></i><span data-ump-quality-badge></span></strong>
            <span class="ump__quality-text" data-ump-quality-text hidden></span>
          </span>
        </div>
        <p class="ump__note" data-ump-note hidden></p>
      </div>
      <div class="ump__price-strip" data-ump-price-strip hidden></div>
      <div class="ump__actions">
        {%- comment -%} data-gs-event keeps third-party gang-sheet scripts (DripApps) from hijacking these buttons {%- endcomment -%}
        <button class="ump__btn ump__btn--primary ump__cart" type="button" data-ump-add data-gs-event="click" data-default-label="{{ block.settings.add_to_cart_label | default: 'Add to cart' | escape }}" disabled>
          <span>{{ block.settings.add_to_cart_label | default: 'Add to cart' }}</span>
        </button>
        {%- if block.settings.enable_checkout_button -%}
          <button class="ump__btn ump__btn--accent ump__checkout" type="button" data-ump-checkout data-gs-event="click" data-default-label="{{ block.settings.checkout_label | default: 'Checkout' | escape }}" disabled>
            <span>{{ block.settings.checkout_label | default: 'Checkout' }}</span>
          </button>
        {%- endif -%}
      </div>
      {%- comment -%} Cart total badge: Σ(variant price × sheets) — the exact Shopify cart amount. {%- endcomment -%}
      <div class="ump__total" data-ump-total hidden>
        <div class="ump__total-head">
          <span class="ump__total-label">Cart total</span>
          <span class="ump__total-meta" data-ump-total-meta></span>
          <strong class="ump__total-value" data-ump-total-value></strong>
        </div>
        <ul class="ump__total-lines" data-ump-total-lines></ul>
      </div>
      <p class="ump__error" data-ump-error hidden></p>
    </aside>
  </div>
</section>
{% schema %}
{
  "name": "Main product upload",
  "target": "section",
  "templates": ["product"],
  "settings": [
    {
      "type": "paragraph",
      "content": "Upload-only main product section. It measures each gang sheet, chooses the fitting sheet variant, then unlocks Add to cart and Checkout."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upload your gang sheet"
    },
    {
      "type": "text",
      "id": "upload_label",
      "label": "Upload button label",
      "default": "Upload files"
    },
    {
      "type": "text",
      "id": "accepted_files",
      "label": "Accepted file extensions",
      "default": ".png,.jpg,.jpeg,.webp,.tif,.tiff,.psd,.pdf,.ai,.eps,.svg,image/png,image/jpeg,image/webp,image/tiff,image/x-tiff,image/vnd.adobe.photoshop,application/vnd.adobe.photoshop,application/x-photoshop,image/x-psd,application/photoshop,application/psd,application/pdf,application/postscript,application/illustrator,application/vnd.adobe.illustrator,application/eps,application/x-eps,image/x-eps,image/svg+xml"
    },
    {
      "type": "text",
      "id": "roll_width_in",
      "label": "Roll width in inches",
      "default": "22"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#4f7cff"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "enable_checkout_button",
      "label": "Show checkout button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_title",
      "label": "Show product name above the uploader",
      "default": true
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout label",
      "default": "Checkout"
    }
  ]
}
{% endschema %}
