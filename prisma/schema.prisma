


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false) @map("is_online")
  scope         String?
  expires       DateTime?
  accessToken   String?   @map("access_token")
  userId        BigInt?   @map("user_id")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String?
  accountOwner  Boolean   @default(false) @map("account_owner")
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false) @map("email_verified")

  @@map("sessions")
}




model Shop {
  id              String @id @default(cuid())
  shopDomain      String @unique @map("shop_domain")
  accessToken     String @map("access_token")
  plan            String @default("free")
  billingStatus   String @default("active") @map("billing_status")
  storageProvider String @default("local") @map("storage_provider")
  storageConfig   Json?  @map("storage_config_json")
  settings        Json?  @map("settings_json")


  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingStep      Int     @default(0) @map("onboarding_step")
  onboardingData      Json?   @map("onboarding_data_json")


  paypalVaultId     String?   @map("paypal_vault_id")
  paypalPayerId     String?   @map("paypal_payer_id")
  paypalPayerEmail  String?   @map("paypal_payer_email")
  paypalAutoCharge  Boolean   @default(false) @map("paypal_auto_charge")
  paypalVaultedAt   DateTime? @map("paypal_vaulted_at")


  stripeCustomerId      String?   @map("stripe_customer_id")
  stripePaymentMethodId String?   @map("stripe_payment_method_id")
  stripeAutoCharge      Boolean   @default(false) @map("stripe_auto_charge")
  stripeEmail           String?   @map("stripe_email")
  stripeSetupAt         DateTime? @map("stripe_setup_at")

  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  productsConfig   ProductConfig[]
  assetSets        AssetSet[]
  uploads          Upload[]
  ordersLink       OrderLink[]
  exportJobs       ExportJob[]
  auditLogs        AuditLog[]
  teamMembers      TeamMember[]
  apiKeys          ApiKey[]
  whiteLabelConfig WhiteLabelConfig?
  flowTriggers     FlowTrigger[]
  visitors         Visitor[]
  visitorSessions  VisitorSession[]
  commissions      Commission[]

  @@map("shops")
}




model ProductConfig {
  id        String @id @default(cuid())
  shopId    String @map("shop_id")
  productId String @map("product_id")


  uploadEnabled Boolean @default(true) @map("upload_enabled")



  extraQuestions Json? @map("extra_questions_json")


  tshirtEnabled Boolean @default(false) @map("tshirt_enabled")
  tshirtConfig  Json?   @map("tshirt_config_json")








  mode            String  @default("dtf")
  enabled         Boolean @default(true)
  assetSetId      String? @map("asset_set_id")
  policyOverrides Json?   @map("policy_overrides_json")



  builderConfig Json? @map("builder_config_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assetSet AssetSet? @relation(fields: [assetSetId], references: [id])

  @@unique([shopId, productId])
  @@map("products_config")
}




model AssetSet {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  name         String
  schema       Json     @map("schema_json")
  thumbnailUrl String?  @map("thumbnail_url")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")


  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productsConfig ProductConfig[]

  @@map("asset_sets")
}




model Upload {
  id               String    @id @default(cuid())
  shopId           String    @map("shop_id")
  productId        String?   @map("product_id")
  variantId        String?   @map("variant_id")
  orderId          String?   @map("order_id")
  mode             String
  status           String    @default("draft")
  customerId       String?   @map("customer_id")
  customerEmail    String?   @map("customer_email")
  preflightSummary Json?     @map("preflight_summary_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  approvedAt       DateTime? @map("approved_at")
  rejectedAt       DateTime? @map("rejected_at")




  visitorId String? @map("visitor_id")
  sessionId String? @map("session_id")




  cartAddedAt   DateTime? @map("cart_added_at")
  cartToken     String?   @map("cart_token")
  // Customer's nesting request, written at add-to-cart time and shown on the
  // order line / identity page so the print shop knows how many copies to gang.
  requestedCopies Int?    @map("requested_copies")
  designsPerSheet Int?    @map("designs_per_sheet")
  sheetsNeeded    Int?    @map("sheets_needed")
  cartVariantId   String? @map("cart_variant_id")
  cartSheetLabel  String? @map("cart_sheet_label")
  orderName     String?   @map("order_name")
  orderPaidAt   DateTime? @map("order_paid_at")
  orderTotal    Decimal?  @map("order_total") @db.Decimal(10, 2)
  orderCurrency String?   @map("order_currency")


  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items      UploadItem[]
  ordersLink OrderLink[]
  visitor    Visitor?        @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  session    VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([shopId, cartToken])
  @@index([visitorId])
  @@index([sessionId])
  @@index([orderPaidAt])
  @@map("uploads")
}




model UploadItem {
  id              String   @id @default(cuid())
  uploadId        String   @map("upload_id")
  location        String
  storageKey      String   @map("storage_key")
  previewKey      String?  @map("preview_key")
  thumbnailKey    String?  @map("thumbnail_key")
  originalName    String?  @map("original_name")
  mimeType        String?  @map("mime_type")
  fileSize        Int?     @map("file_size")
  uploadDurationMs Int?    @map("upload_duration_ms")
  fingerprint     String?  @map("fingerprint")
  transform       Json?    @map("transform_json")
  preflightStatus String   @default("pending") @map("preflight_status")
  preflightResult Json?    @map("preflight_result_json")
  createdAt       DateTime @default(now()) @map("created_at")


  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
  @@map("upload_items")
}




model OrderLink {
  id         String   @id @default(cuid())
  shopId     String   @map("shop_id")
  orderId    String   @map("order_id")
  uploadId   String   @map("upload_id")
  lineItemId String?  @map("line_item_id")
  createdAt  DateTime @default(now()) @map("created_at")


  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)


  @@unique([orderId, uploadId], name: "orderId_uploadId")
  @@map("orders_link")
}




model ExportJob {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  uploadIds   String[]  @map("upload_ids")
  status      String    @default("pending")
  downloadUrl String?   @map("download_url")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}




model AuditLog {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("audit_logs")
}




model TeamMember {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  email       String
  name        String?
  role        String    @default("viewer")
  inviteToken String?   @map("invite_token")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  acceptedAt  DateTime? @map("accepted_at")
  lastLoginAt DateTime? @map("last_login_at")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@map("team_members")
}




model ApiKey {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  name        String
  keyHash     String    @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  permissions String[]
  rateLimit   Int       @default(100) @map("rate_limit")
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  usageCount  Int       @default(0) @map("usage_count")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@map("api_keys")
}




model WhiteLabelConfig {
  id             String   @id @default(cuid())
  shopId         String   @unique @map("shop_id")
  enabled        Boolean  @default(false)
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  customCss      String?  @map("custom_css")
  hideBranding   Boolean  @default(false) @map("hide_branding")
  customDomain   String?  @map("custom_domain")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("white_label_config")
}




model FlowTrigger {
  id         String    @id @default(cuid())
  shopId     String    @map("shop_id")
  eventType  String    @map("event_type")
  resourceId String    @map("resource_id")
  payload    Json      @map("payload_json")
  status     String    @default("pending")
  attempts   Int       @default(0)
  sentAt     DateTime? @map("sent_at")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, eventType])
  @@map("flow_triggers")
}




model SupportTicket {
  id           String @id @default(cuid())
  ticketNumber String @unique @map("ticket_number")


  name       String
  email      String
  shopDomain String? @map("shop_domain")


  category String
  subject  String
  message  String @db.Text


  status   String @default("open")
  priority String @default("normal")


  assignedTo String? @map("assigned_to")


  emailSentAt  DateTime? @map("email_sent_at")
  firstReplyAt DateTime? @map("first_reply_at")
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  replies SupportReply[]

  @@index([email])
  @@index([status])
  @@index([shopDomain])
  @@map("support_tickets")
}

model SupportReply {
  id       String @id @default(cuid())
  ticketId String @map("ticket_id")


  message     String  @db.Text
  isStaff     Boolean @default(false) @map("is_staff")
  authorName  String  @map("author_name")
  authorEmail String  @map("author_email")


  emailSentAt DateTime? @map("email_sent_at")

  createdAt DateTime @default(now()) @map("created_at")


  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_replies")
}




model Visitor {
  id     String @id @default(cuid())
  shopId String @map("shop_id")




  fingerprint    String?
  localStorageId String  @map("local_storage_id")




  deviceType       String? @map("device_type")
  browser          String?
  browserVersion   String? @map("browser_version")
  os               String?
  osVersion        String? @map("os_version")
  screenResolution String? @map("screen_resolution")
  language         String?
  timezone         String?




  country String?
  region  String?
  city    String?




  firstSeenAt   DateTime @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime @updatedAt @map("last_seen_at")
  totalSessions Int      @default(1) @map("total_sessions")
  totalUploads  Int      @default(0) @map("total_uploads")
  totalOrders   Int      @default(0) @map("total_orders")
  totalRevenue  Decimal? @map("total_revenue") @db.Decimal(10, 2)




  consentGiven     Boolean   @default(false) @map("consent_given")
  consentTimestamp DateTime? @map("consent_timestamp")
  degradedMode     Boolean   @default(false) @map("degraded_mode")




  shopifyCustomerId String? @map("shopify_customer_id")
  customerEmail     String? @map("customer_email")




  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sessions VisitorSession[]
  uploads  Upload[]




  @@unique([shopId, fingerprint], name: "visitor_shop_fingerprint")
  @@unique([shopId, localStorageId], name: "visitor_shop_localStorage")
  @@index([shopId, firstSeenAt])
  @@index([shopId, country])
  @@index([shopId, shopifyCustomerId])
  @@map("visitors")
}




model VisitorSession {
  id        String @id @default(cuid())
  shopId    String @map("shop_id")
  visitorId String @map("visitor_id")




  sessionToken String @map("session_token")




  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")




  gclid   String?
  fbclid  String?
  msclkid String?
  ttclid  String?




  referrer       String? @db.Text
  referrerDomain String? @map("referrer_domain")
  referrerType   String? @map("referrer_type")
  landingPage    String? @map("landing_page") @db.Text
  landingPath    String? @map("landing_path")




  startedAt      DateTime @default(now()) @map("started_at")
  lastActivityAt DateTime @updatedAt @map("last_activity_at")




  pageViews        Int @default(1) @map("page_views")
  uploadsInSession Int @default(0) @map("uploads_in_session")
  addToCartCount   Int @default(0) @map("add_to_cart_count")




  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  visitor Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  uploads Upload[]




  @@unique([shopId, sessionToken], name: "session_shop_token")
  @@index([shopId, startedAt])
  @@index([shopId, utmSource])
  @@index([shopId, utmCampaign])
  @@index([shopId, referrerType])
  @@index([visitorId])
  @@map("visitor_sessions")
}






model Commission {
  id            String   @id @default(cuid())
  shopId        String   @map("shop_id")
  orderId       String   @map("order_id")
  orderNumber   String?  @map("order_number")


  orderTotal    Decimal  @map("order_total") @db.Decimal(10, 2)
  orderCurrency String   @default("USD") @map("order_currency")


  commissionRate Decimal @default(0.015) @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount Decimal @map("commission_amount") @db.Decimal(10, 2)


  status          String   @default("pending")
  paidAt          DateTime? @map("paid_at")
  paymentRef      String?  @map("payment_ref")
  paymentProvider String?  @map("payment_provider")


  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId], name: "commission_shop_order")
  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@map("commissions")
}




model UploadLog {
  id        String   @id @default(cuid())


  event     String
  level     String
  traceId   String?  @map("trace_id")


  uploadId  String?  @map("upload_id")
  itemId    String?  @map("item_id")
  shopId    String?  @map("shop_id")


  provider  String?


  context   Json?    @map("context_json")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([uploadId])
  @@index([shopId, createdAt])
  @@index([event, level])
  @@index([traceId])
  @@index([createdAt])
  @@map("upload_logs")
}
