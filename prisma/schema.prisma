


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false) @map("is_online")
  scope         String?
  expires       DateTime?
  accessToken   String?   @map("access_token")
  userId        BigInt?   @map("user_id")
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String?
  accountOwner  Boolean   @default(false) @map("account_owner")
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false) @map("email_verified")
  refreshToken String? @map("refresh_token")
  refreshTokenExpires DateTime? @map("refresh_token_expires")

  @@index([shop])
  @@map("sessions")
}




model Shop {
  id              String @id @default(cuid())
  shopDomain      String @unique @map("shop_domain")
  accessToken     String @map("access_token")
  plan            String @default("free")
  billingStatus   String @default("inactive") @map("billing_status")
  uninstalledAt   DateTime? @map("uninstalled_at")
  erasureStartedAt DateTime? @map("erasure_started_at")
  storageProvider String @default("local") @map("storage_provider")
  storageConfig   Json?  @map("storage_config_json")
  settings        Json?  @map("settings_json")


  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingStep      Int     @default(0) @map("onboarding_step")
  onboardingData      Json?   @map("onboarding_data_json")





  installedAt DateTime @default(now()) @map("installed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  productsConfig   ProductConfig[]
  assetSets        AssetSet[]
  uploads          Upload[]
  ordersLink       OrderLink[]
  exportJobs       ExportJob[]
  auditLogs        AuditLog[]
  teamMembers      TeamMember[]
  apiKeys          ApiKey[]
  whiteLabelConfig WhiteLabelConfig?
  flowTriggers     FlowTrigger[]
  commissions      Commission[]
  billing          ShopBilling?
  uploadLogs       UploadLog[]
  billingCredits   BillingCredit[]
  supportTickets   SupportTicket[]
  paidSheetVolumes PaidSheetVolume[]

  @@map("shops")
}




model ProductConfig {
  id        String @id @default(cuid())
  shopId    String @map("shop_id")
  productId String @map("product_id")


  uploadEnabled Boolean @default(true) @map("upload_enabled")



  extraQuestions Json? @map("extra_questions_json")


  tshirtEnabled Boolean @default(false) @map("tshirt_enabled")
  tshirtConfig  Json?   @map("tshirt_config_json")








  mode            String  @default("dtf")
  enabled         Boolean @default(true)
  assetSetId      String? @map("asset_set_id")
  policyOverrides Json?   @map("policy_overrides_json")



  builderConfig Json? @map("builder_config_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assetSet AssetSet? @relation(fields: [assetSetId], references: [id])

  @@unique([shopId, productId])
  @@map("products_config")
}




model AssetSet {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  name         String
  schema       Json     @map("schema_json")
  thumbnailUrl String?  @map("thumbnail_url")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")


  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productsConfig ProductConfig[]

  @@map("asset_sets")
}




model Upload {
  id               String    @id @default(cuid())
  shopId           String    @map("shop_id")
  privacyRedactedAt DateTime? @map("privacy_redacted_at")
  productId        String?   @map("product_id")
  variantId        String?   @map("variant_id")
  orderId          String?   @map("order_id")
  mode             String
  status           String    @default("draft")
  customerId       String?   @map("customer_id")
  preflightSummary Json?     @map("preflight_summary_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  approvedAt       DateTime? @map("approved_at")
  rejectedAt       DateTime? @map("rejected_at")








  cartAddedAt   DateTime? @map("cart_added_at")
  cartToken     String?   @map("cart_token")
  // Quantity columns predate the finished-sheet rule. The nullable marker is
  // the only proof that a row was written with one-file/one-sheet semantics;
  // unmarked historical rows must fail closed instead of being reinterpreted.
  quantitySemantics String? @map("quantity_semantics")
  requestedCopies   Int?    @map("requested_copies")
  designsPerSheet   Int?    @map("designs_per_sheet")
  sheetsNeeded      Int?    @map("sheets_needed")
  cartVariantId     String? @map("cart_variant_id")
  cartSheetLabel    String? @map("cart_sheet_label")
  // Public checkout facts are accepted once; quantities belong to paid order lines.
  checkoutUnitBillableInches Decimal? @map("checkout_unit_billable_inches") @db.Decimal(12, 4)
  checkoutPricingMode String? @map("checkout_pricing_mode")
  checkoutVariantId String? @map("checkout_variant_id")
  checkoutQuoteAcceptedAt DateTime? @map("checkout_quote_accepted_at")
  orderName     String?   @map("order_name")
  orderPaidAt   DateTime? @map("order_paid_at")
  orderTotal    Decimal?  @map("order_total") @db.Decimal(10, 2)
  orderCurrency String?   @map("order_currency")


  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items      UploadItem[]
  ordersLink OrderLink[]

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([shopId, cartToken])
  @@index([orderPaidAt])
  @@map("uploads")
}




model UploadItem {
  id              String   @id @default(cuid())
  uploadId        String   @map("upload_id")
  location        String
  storageKey      String   @map("storage_key")
  previewKey      String?  @map("preview_key")
  thumbnailKey    String?  @map("thumbnail_key")
  originalName    String?  @map("original_name")
  mimeType        String?  @map("mime_type")
  fileSize        Int?     @map("file_size")
  uploadDurationMs Int?    @map("upload_duration_ms")
  fingerprint     String?  @map("fingerprint")
  transform       Json?    @map("transform_json")
  preflightStatus String   @default("pending") @map("preflight_status")
  preflightResult Json?    @map("preflight_result_json")
  createdAt       DateTime @default(now()) @map("created_at")


  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([fingerprint])
  @@map("upload_items")
}




model OrderLink {
  id         String   @id @default(cuid())
  shopId     String   @map("shop_id")
  orderId    String   @map("order_id")
  uploadId   String   @map("upload_id")
  lineItemId String?  @map("line_item_id")
  createdAt  DateTime @default(now()) @map("created_at")


  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)


  @@unique([shopId, orderId, uploadId], name: "shopId_orderId_uploadId")
  @@map("orders_link")
}

// Accounting-only film facts outlive production file retention. Scalar IDs
// are audit references, not relations that cascade with the uploaded bytes.
model PaidSheetVolume {
  id String @id
  shopId String @map("shop_id")
  orderId String @map("order_id")
  lineItemId String @map("line_item_id")
  uploadId String @map("upload_id")
  paidAt DateTime @map("paid_at")
  paidCustomerId String? @map("paid_customer_id")
  paidQuantity Int @map("paid_quantity")
  paidUnitBillableInches Decimal @map("paid_unit_billable_inches") @db.Decimal(12, 4)
  paidBillableInches Decimal @map("paid_billable_inches") @db.Decimal(16, 4)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, orderId, lineItemId])
  @@index([shopId, paidCustomerId, paidAt])
  @@map("paid_sheet_volume")
}




model ExportJob {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  storageKey  String?   @map("storage_key")
  uploadIds   String[]  @map("upload_ids")
  status      String    @default("pending")
  downloadUrl String?   @map("download_url")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("export_jobs")
}




model AuditLog {
  id           String   @id @default(cuid())
  shopId       String   @map("shop_id")
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@map("audit_logs")
}




model TeamMember {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  email       String
  name        String?
  role        String    @default("viewer")
  inviteToken String?   @map("invite_token")
  invitedAt   DateTime  @default(now()) @map("invited_at")
  acceptedAt  DateTime? @map("accepted_at")
  lastLoginAt DateTime? @map("last_login_at")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
  @@map("team_members")
}




model ApiKey {
  id          String    @id @default(cuid())
  shopId      String    @map("shop_id")
  name        String
  keyHash     String    @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  permissions String[]
  rateLimit   Int       @default(100) @map("rate_limit")
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  usageCount  Int       @default(0) @map("usage_count")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@map("api_keys")
}




model WhiteLabelConfig {
  id             String   @id @default(cuid())
  shopId         String   @unique @map("shop_id")
  enabled        Boolean  @default(false)
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @map("primary_color")
  secondaryColor String?  @map("secondary_color")
  customCss      String?  @map("custom_css")
  hideBranding   Boolean  @default(false) @map("hide_branding")
  customDomain   String?  @map("custom_domain")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("white_label_config")
}




model FlowTrigger {
  id         String    @id @default(cuid())
  shopId     String    @map("shop_id")
  eventType  String    @map("event_type")
  resourceId String    @map("resource_id")
  payload    Json      @map("payload_json")
  status     String    @default("pending")
  attempts   Int       @default(0)
  sentAt     DateTime? @map("sent_at")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, eventType])
  @@map("flow_triggers")
}




model SupportTicket {
  id           String @id @default(cuid())
  shopId       String @map("shop_id")
  shop         Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ticketNumber String @unique @map("ticket_number")


  name       String
  email      String
  shopDomain String? @map("shop_domain")


  category String
  subject  String
  message  String @db.Text


  status   String @default("open")
  priority String @default("normal")


  assignedTo String? @map("assigned_to")


  emailSentAt  DateTime? @map("email_sent_at")
  firstReplyAt DateTime? @map("first_reply_at")
  resolvedAt   DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  replies SupportReply[]

  @@index([email])
  @@index([status])
  @@index([shopDomain])
  @@index([shopId])
  @@map("support_tickets")
}

model SupportReply {
  id       String @id @default(cuid())
  ticketId String @map("ticket_id")


  message     String  @db.Text
  isStaff     Boolean @default(false) @map("is_staff")
  authorName  String  @map("author_name")
  authorEmail String  @map("author_email")


  emailSentAt DateTime? @map("email_sent_at")

  createdAt DateTime @default(now()) @map("created_at")


  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("support_replies")
}










model Commission {
  id            String   @id @default(cuid())
  shopId        String   @map("shop_id")
  orderId       String   @map("order_id")
  orderNumber   String?  @map("order_number")


  orderTotal    Decimal  @map("order_total") @db.Decimal(10, 2)
  orderCurrency String   @default("USD") @map("order_currency")


  commissionRate Decimal @default(0.035) @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount Decimal @map("commission_amount") @db.Decimal(10, 2)


  status          String   @default("pending")
  paidAt          DateTime? @map("paid_at")
  paymentRef      String?  @map("payment_ref")
  paymentProvider String?  @map("payment_provider")
  billingCurrency String @default("USD") @map("billing_currency")
  servedAmountUsd Decimal? @map("served_amount_usd") @db.Decimal(12, 2)
  fxRate Decimal? @map("fx_rate") @db.Decimal(20, 10)
  fxSource String? @map("fx_source")
  fxObservedAt DateTime? @map("fx_observed_at")
  usageIdempotencyKey String? @unique @map("usage_idempotency_key")
  usageLineItemId String? @map("usage_line_item_id")
  usageSubscriptionId String? @map("usage_subscription_id")
  usageRecordId String? @unique @map("usage_record_id")
  usageRequestStartedAt DateTime? @map("usage_request_started_at")
  nextBillingAttemptAt DateTime? @map("next_billing_attempt_at")
  billingLastError String? @map("billing_last_error")

  // `pending` is collectible only when Shopify capture evidence exists.
  // Nullable-by-design makes pre-migration rows fail closed until a fresh
  // order fact is reconciled; no historical payment state is guessed.
  collectibleAt               DateTime? @map("collectible_at")
  eligibilitySource           String?   @map("eligibility_source")
  attributableCapturedAmount  Decimal?  @map("attributable_captured_amount") @db.Decimal(10, 2)
  shopifyFinancialStatus      String?   @map("shopify_financial_status")
  shopifyRefundStatus         String?   @map("shopify_refund_status")
  shopifyCancelledAt          DateTime? @map("shopify_cancelled_at")
  shopifyObservedAt           DateTime? @map("shopify_observed_at")
  reviewRequiredAt            DateTime? @map("review_required_at")
  reviewReason                String?   @map("review_reason")


  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")


  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId], name: "commission_shop_order")
  @@index([shopId, status])
  @@index([shopId, status, collectibleAt])
  @@index([shopId, createdAt])
  @@map("commissions")
}




model UploadLog {
  id        String   @id @default(cuid())


  event     String
  level     String
  traceId   String?  @map("trace_id")


  uploadId  String?  @map("upload_id")
  itemId    String?  @map("item_id")
  shopId    String   @map("shop_id")


  provider  String?


  context   Json?    @map("context_json")

  createdAt DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([uploadId])
  @@index([shopId, createdAt])
  @@index([event, level])
  @@index([traceId])
  @@index([createdAt])
  @@map("upload_logs")
}

model ShopBilling {
  id String @id @default(cuid())
  shopId String @unique @map("shop_id")
  subscriptionId String? @map("subscription_id")
  usageLineItemId String? @map("usage_line_item_id")
  status String @default("inactive")
  cappedAmountUsd Decimal @default(0) @map("capped_amount_usd") @db.Decimal(12, 2)
  balanceUsedUsd Decimal @default(0) @map("balance_used_usd") @db.Decimal(12, 2)
  currentPeriodEnd DateTime? @map("current_period_end")
  pendingApprovalUrl String? @map("pending_approval_url")
  pendingCapUsd Decimal? @map("pending_cap_usd") @db.Decimal(12, 2)
  test Boolean @default(false)
  syncedAt DateTime? @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@map("shop_billing")
}

model BillingCredit {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  commissionId String @map("commission_id")
  amountUsd Decimal @map("amount_usd") @db.Decimal(12, 2)
  status String @default("review")
  providerRef String? @map("provider_ref")
  idempotencyKey String @unique @map("idempotency_key")
  requestedAt DateTime @default(now()) @map("requested_at")
  settledAt DateTime? @map("settled_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId, status])
  @@map("billing_credits")
}

// Inbox is independent of Shop so a completed erasure can remain deduplicated
// without recreating a deleted tenant or retaining the request payload.
model ComplianceRequest {
  id String @id @default(cuid())
  shopDomain String @map("shop_domain")
  topic String
  eventId String @map("event_id")
  payload Json?
  status String @default("pending")
  dueAt DateTime @default(now()) @map("due_at")
  attempts Int @default(0)
  lastError String? @map("last_error")
  result Json?
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  leaseUntil DateTime? @map("lease_until")
  leaseToken String? @map("lease_token")
  @@unique([shopDomain, topic, eventId], name: "compliance_shop_topic_event")
  @@index([status, dueAt])
  @@map("compliance_requests")
}
