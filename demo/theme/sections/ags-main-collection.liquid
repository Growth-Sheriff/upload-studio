<section class="ags-wrap ags-collection"><span class="ags-kicker">ALREADY ARRANGED, READY TO UPLOAD</span><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="ags-prose">{{ collection.description }}</div>{% endif %}
  {% paginate collection.products by 12 %}<div class="ags-collection-grid">
    {% for card_product in collection.products %}<article class="ags-collection-card"><a class="ags-collection-image" href="{{ card_product.url }}">{% if card_product.featured_image %}{{ card_product.featured_image | image_url: width: 700 | image_tag: widths: '300,450,700', sizes: '(min-width: 900px) 30vw, 90vw', loading: 'lazy', alt: card_product.title }}{% else %}{% render 'ags-film-art', kind: card_product.handle %}{% endif %}</a><h2><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h2>{% if card_product.handle == 'measured-dtf-gang-sheets' or card_product.handle == 'measured-dtf-png-sheets' %}<p><strong>$0.30 / measured inch</strong> · Final sheet quote after upload</p>{% else %}<p>From <strong>{{ card_product.price | money }}</strong> per sheet</p>{% endif %}<a class="ags-text-link" href="{{ card_product.url }}">Open uploader <span aria-hidden="true">↗</span></a></article>{% else %}<p>No demo products have been published in this collection yet.</p>{% endfor %}
  </div>{% if paginate.pages > 1 %}<nav class="ags-pagination" aria-label="Collection pages">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}
</section>
{% schema %}{"name":"Sheet collection","settings":[]}{% endschema %}
