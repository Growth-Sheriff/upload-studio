<section class="ags-wrap ags-page"><span class="ags-kicker">FIND A DEMO PRODUCT</span><h1>Search.</h1><form class="ags-search" action="{{ routes.search_url }}" method="get"><label for="Search">Product or guide</label><div><input id="Search" type="search" name="q" value="{{ search.terms | escape }}"><button class="ags-button" type="submit">Search</button></div></form>
{% if search.performed %}{% paginate search.results by 12 %}<ul class="ags-search-results">{% for result in search.results %}<li><a href="{{ result.url }}">{{ result.title | escape }}</a></li>{% else %}<li>No results. <a href="{{ routes.collections_url }}/ready-sheet-examples">Browse finished-sheet examples</a>.</li>{% endfor %}</ul>{% if paginate.pages > 1 %}{{ paginate | default_pagination }}{% endif %}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Demo search","settings":[]}{% endschema %}
