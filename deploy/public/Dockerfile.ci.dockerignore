!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!vite.config.ts
!vitest.config.ts
!server.mjs
!shopify.app.auto-gang-sheet-upload.toml
!app/
!app/**
!workers/
!workers/**
!public/
!public/**
!prisma/
!prisma/**
!extensions/
!extensions/**
!theme-snippets/
!theme-snippets/**
!scripts/
