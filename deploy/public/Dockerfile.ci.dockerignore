!scripts/measurement-regression-fixtures.json
!deploy/
!deploy/public/
!deploy/public/verify.sh
!deploy/public/Dockerfile.ci
!deploy/public/Dockerfile.ci.dockerignore
**/node_modules/**
**/.env*
**/*.log
**/uploads/**
**/tmp/**
**/temp/**
