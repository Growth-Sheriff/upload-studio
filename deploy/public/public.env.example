NODE_ENV=production
PUBLIC_APP_RUNTIME=true
PORT=3000
SHOPIFY_APP_URL=https://NEW_PUBLIC_HOST_REQUIRED
SHOPIFY_API_KEY=NEW_ACTUALSCOPE_PUBLIC_APP_KEY_REQUIRED
SHOPIFY_API_SECRET=NEW_ACTUALSCOPE_PUBLIC_APP_SECRET_REQUIRED
DATABASE_URL=postgresql://NEW_PUBLIC_USER:NEW_PUBLIC_PASSWORD@NEW_PUBLIC_DATABASE/public_app?schema=public
REDIS_URL=rediss://NEW_PUBLIC_USER:NEW_PUBLIC_PASSWORD@NEW_PUBLIC_REDIS:6379/0
SECRET_KEY=NEW_RANDOM_CAPABILITY_SECRET_REQUIRED
PUBLIC_OPERATIONS_TOKEN=NEW_RANDOM_OPERATIONS_TOKEN_REQUIRED
DEFAULT_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=NEW_PUBLIC_R2_ACCOUNT_REQUIRED
R2_ACCESS_KEY_ID=NEW_PUBLIC_R2_KEY_REQUIRED
R2_SECRET_ACCESS_KEY=NEW_PUBLIC_R2_SECRET_REQUIRED
R2_BUCKET_NAME=auto-gang-sheet-public
# Original customer files stay private; signed download capabilities serve them.
R2_PUBLIC_URL=
MEASURE_WORKER_CONCURRENCY=1
PREVIEW_WORKER_CONCURRENCY=1
MEASURE_JOB_BUDGET_MS=300000
PREVIEW_JOB_BUDGET_MS=180000
SHOPIFY_BILLING_TEST=false
